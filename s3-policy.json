{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::samuel-video-processing-video",
        "arn:aws:s3:::samuel-video-processing-video/*",
        "arn:aws:s3:::samuel-video-processing-audio",
        "arn:aws:s3:::samuel-video-processing-audio/*",
        "arn:aws:s3:::video-converter-thumbnails-sam",
        "arn:aws:s3:::video-converter-thumbnails-sam/*"
      ]
    },
    {
      "_comment": "Pinned to the project S3 CMK (alias video-processing-production-s3) in account 009850210027 / eu-central-1. The trailing key/* wildcard covers the CMK key-id ARN; replace the account/region/key-id below if the CMK is recreated. kms:ViaService keeps usage restricted to S3.",
      "Sid": "AllowKmsForS3CmkEncryption",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Resource": [
        "arn:aws:kms:eu-central-1:009850210027:alias/video-processing-production-s3",
        "arn:aws:kms:eu-central-1:009850210027:key/*"
      ],
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.eu-central-1.amazonaws.com"
        }
      }
    }
  ]
}
