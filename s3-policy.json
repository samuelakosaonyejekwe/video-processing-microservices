{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::video-converter-uploads-sam",
        "arn:aws:s3:::video-converter-uploads-sam/*",
        "arn:aws:s3:::video-converter-audio-sam",
        "arn:aws:s3:::video-converter-audio-sam/*",
        "arn:aws:s3:::video-converter-thumbnails-sam",
        "arn:aws:s3:::video-converter-thumbnails-sam/*"
      ]
    }
  ]
}
