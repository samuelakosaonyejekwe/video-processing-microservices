name: Docker Build and Push

on:

  push:
    branches:
      - main

jobs:

  docker-build:

    runs-on: ubuntu-latest

    steps:

      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set Up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Login to DockerHub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKER_USERNAME }}
          password: ${{ secrets.DOCKER_PASSWORD }}

      - name: Build Gateway Image
        run: |
          docker build \
          -t ${{ secrets.DOCKER_USERNAME }}/gateway-service:latest \
          ./services/gateway

      - name: Build Auth Image
        run: |
          docker build \
          -t ${{ secrets.DOCKER_USERNAME }}/auth-service:latest \
          ./services/auth

      - name: Build Converter Image
        run: |
          docker build \
          -t ${{ secrets.DOCKER_USERNAME }}/converter-service:latest \
          ./services/converter

      - name: Build Notification Image
        run: |
          docker build \
          -t ${{ secrets.DOCKER_USERNAME }}/notification-service:latest \
          ./services/notification

      - name: Push Gateway Image
        run: |
          docker push \
          ${{ secrets.DOCKER_USERNAME }}/gateway-service:latest

      - name: Push Auth Image
        run: |
          docker push \
          ${{ secrets.DOCKER_USERNAME }}/auth-service:latest

      - name: Push Converter Image
        run: |
          docker push \
          ${{ secrets.DOCKER_USERNAME }}/converter-service:latest

      - name: Push Notification Image
        run: |
          docker push \
          ${{ secrets.DOCKER_USERNAME }}/notification-service:latest