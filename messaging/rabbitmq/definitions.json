{
  "queues": [
    {
      "name": "${VIDEO_UPLOAD_QUEUE}",
      "durable": true,
      "arguments": {
        "x-dead-letter-exchange": "video.dlx"
      }
    },

    {
      "name": "${VIDEO_UPLOAD_RETRY_QUEUE}",
      "durable": true,
      "arguments": {
        "x-message-ttl": 30000,
        "x-dead-letter-exchange": "",
        "x-dead-letter-routing-key": "${VIDEO_UPLOAD_QUEUE}"
      }
    },

    {
      "name": "${VIDEO_UPLOAD_DLQ}",
      "durable": true
    },

    {
      "name": "${NOTIFICATION_QUEUE}",
      "durable": true
    }
  ],

  "exchanges": [
    {
      "name": "video.dlx",
      "type": "direct",
      "durable": true
    }
  ],

  "bindings": [
    {
      "source": "video.dlx",
      "destination": "${VIDEO_UPLOAD_DLQ}",
      "destination_type": "queue",
      "routing_key": "failed"
    }
  ]
}