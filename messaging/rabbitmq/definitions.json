{
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "queues": [
    {
      "name": "${VIDEO_UPLOAD_QUEUE}",
      "vhost": "/",
      "durable": true,
      "arguments": {
        "x-dead-letter-exchange": "video.dlx",
        "x-dead-letter-routing-key": "failed"
      }
    },
    {
      "name": "${VIDEO_UPLOAD_RETRY_QUEUE}",
      "vhost": "/",
      "durable": true,
      "arguments": {
        "x-message-ttl": 30000,
        "x-dead-letter-exchange": "",
        "x-dead-letter-routing-key": "${VIDEO_UPLOAD_QUEUE}"
      }
    },
    {
      "name": "${VIDEO_UPLOAD_DLQ}",
      "vhost": "/",
      "durable": true
    },
    {
      "name": "${NOTIFICATION_QUEUE}",
      "vhost": "/",
      "durable": true
    },
    {
      "name": "${NOTIFICATION_RETRY_QUEUE}",
      "vhost": "/",
      "durable": true,
      "arguments": {
        "x-message-ttl": 30000,
        "x-dead-letter-exchange": "",
        "x-dead-letter-routing-key": "${NOTIFICATION_QUEUE}"
      }
    },
    {
      "name": "${NOTIFICATION_DLQ}",
      "vhost": "/",
      "durable": true
    },
    {
      "name": "${GATEWAY_EVENTS_QUEUE}",
      "vhost": "/",
      "durable": true
    },
    {
      "name": "${VIDEO_COMPLETED_QUEUE}",
      "vhost": "/",
      "durable": true
    },
    {
      "name": "${VIDEO_COMPLETED_RETRY_QUEUE}",
      "vhost": "/",
      "durable": true,
      "arguments": {
        "x-message-ttl": 30000,
        "x-dead-letter-exchange": "",
        "x-dead-letter-routing-key": "${VIDEO_COMPLETED_QUEUE}"
      }
    },
    {
      "name": "${VIDEO_FAILED_QUEUE}",
      "vhost": "/",
      "durable": true
    }
  ],
  "exchanges": [
    {
      "name": "video.dlx",
      "vhost": "/",
      "type": "direct",
      "durable": true
    }
  ],
  "bindings": [
    {
      "source": "video.dlx",
      "vhost": "/",
      "destination": "${VIDEO_UPLOAD_DLQ}",
      "destination_type": "queue",
      "routing_key": "failed"
    }
  ]
}
